SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key
SUPABASE_JWT_SECRET=your-legacy-hs256-jwt-secret-if-required
OPENAI_API_KEY=your-openai-api-key

# Comma-separated browser origins. Do not use * because credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-web-app.example

RAG_MODEL=gpt-4o-mini
EMBER_PLANNER_MODEL=gpt-4o-mini
RAG_EVAL_MODEL=gpt-4o-mini
# Model that writes the cached per-chunk headline and summary during ingestion.
RAG_CHUNK_CONTEXT_MODEL=gpt-4o-mini
# Refusal gate: accept evidence when any chunk reaches RAG_MIN_SIMILARITY, or
# when a chunk found by both keyword and vector search reaches the lower
# RAG_MIN_SIMILARITY_WITH_KEYWORD floor. Calibrated 2026-09-16 against the
# 45-case retrieval set and the 11 refusal cases; see docs/RAG_EVALUATION_BASELINE.md.
RAG_MIN_SIMILARITY=0.45
RAG_MIN_SIMILARITY_WITH_KEYWORD=0.35
# "always" tailors every knowledge answer to the signed-in user's aggregate
# snapshot; "auto" attaches it only when the planner or keyword fallback asks.
EMBER_PERSONALISE_MODE=always

# Per authenticated user, per backend process.
ADVISOR_RATE_LIMIT_REQUESTS=10
ADVISOR_RATE_LIMIT_WINDOW_SECONDS=60

# Category suggestions use a separate authenticated-user limit.
AI_SUGGESTION_RATE_LIMIT_REQUESTS=10
AI_SUGGESTION_RATE_LIMIT_WINDOW_SECONDS=60
