SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key
SUPABASE_JWT_SECRET=your-legacy-hs256-jwt-secret-if-required
OPENAI_API_KEY=your-openai-api-key

# Comma-separated browser origins. Do not use * because credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-web-app.example

RAG_MODEL=gpt-4o-mini
RAG_EVAL_MODEL=gpt-4o-mini
RAG_MIN_SIMILARITY=0.45

# Per authenticated user, per backend process.
ADVISOR_RATE_LIMIT_REQUESTS=10
ADVISOR_RATE_LIMIT_WINDOW_SECONDS=60

# Category suggestions use a separate authenticated-user limit.
AI_SUGGESTION_RATE_LIMIT_REQUESTS=10
AI_SUGGESTION_RATE_LIMIT_WINDOW_SECONDS=60
