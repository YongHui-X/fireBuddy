# Copy to .env.local (ignored by git). All values are optional: without them every screen works and
# Doudou explains that it is not set up. Records never leave the phone either way.

# FastAPI origin for Doudou. A phone on the same Wi-Fi needs the computer's LAN address, not localhost.
# Any build that leaves development must use an https:// address.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000

# Supabase project for Doudou's invisible anonymous session, created only when the user turns
# Doudou on. Enable Anonymous sign-ins under Auth providers in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
