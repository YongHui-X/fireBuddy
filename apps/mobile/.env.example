# Copy to .env.local (ignored by git). Both values are optional; the app runs on local demo data without them.

# FastAPI origin for Ember. A phone on the same Wi-Fi needs the computer's LAN address, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000

# Development only: a Supabase access token copied from a signed-in web session, so Ember can be
# exercised before mobile sign-in exists. Never ship a build with this set.
EXPO_PUBLIC_DEV_ACCESS_TOKEN=
